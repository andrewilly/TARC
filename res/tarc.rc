// ============================================================================
// TARC STRIKE — Resource file per icona Windows
// ============================================================================
// Questo file viene compilato dal Resource Compiler (rc.exe / windres)
// e incorpora l'icona nell'eseguibile finale.
//
// L'icona appare:
//   - Nel file tarc.exe (Esplora risorse, Taskbar, Alt+Tab)
//   - Nei file SFX generati (tarc.exe si copia come stub)
//
// Per personalizzare: sostituisci res/tarc.ico con la tua icona (.ico)
// ============================================================================
#include <windows.h>

// Icona principale dell'applicazione (ID = 1)
IDI_TARC ICON "tarc.ico"

// Informazioni versione (visibili in Proprietà → Dettagli del file)
VS_VERSION_INFO VERSIONINFO
FILEVERSION 2,10,0,0
PRODUCTVERSION 2,10,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"  // English (US), Unicode
        BEGIN
            VALUE "CompanyName",      "TARC STRIKE"
            VALUE "FileDescription",  "TARC STRIKE - Archiver & Compressor"
            VALUE "FileVersion",      "2.10.0"
            VALUE "InternalName",     "tarc"
            VALUE "OriginalFilename", "tarc.exe"
            VALUE "ProductName",      "TARC STRIKE"
            VALUE "ProductVersion",   "2.10.0"
            VALUE "LegalCopyright",   "Copyright (c) 2025"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200  // English (US), Unicode
    END
END
